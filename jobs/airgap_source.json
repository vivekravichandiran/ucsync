{
  "name": "${job_name_prefix} - Airgap Inventory+Export (source)",
  "tags": {
    "utility": "uc-governance-migration",
    "job": "airgap-source"
  },
  "max_concurrent_runs": 1,
  "job_clusters": [
    {
      "job_cluster_key": "uc_migration_cluster",
      "new_cluster": {
        "spark_version": "${spark_version}",
        "node_type_id": "${node_type_id}",
        "num_workers": 1,
        "data_security_mode": "USER_ISOLATION",
        "custom_tags": {
          "uc_migration": "true"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "inventory",
      "job_cluster_key": "uc_migration_cluster",
      "libraries": [
        {
          "pypi": {
            "package": "databricks-sdk>=0.36.0"
          }
        },
        {
          "pypi": {
            "package": "PyYAML>=6.0"
          }
        },
        {
          "pypi": {
            "package": "openpyxl>=3.1"
          }
        }
      ],
      "notebook_task": {
        "notebook_path": "${notebook_dir}/01_Inventory",
        "base_parameters": {
          "connectivity_mode": "airgap",
          "catalogs": "${catalogs}",
          "schemas": "${schemas}",
          "output_volume_path": "${output_volume_path}",
          "ops_catalog": "${ops_catalog}",
          "ops_schema": "${ops_schema}",
          "source_workspace_url": "${source_workspace_url}",
          "source_oauth_secret_scope": "${source_oauth_secret_scope}",
          "source_client_id_secret_key": "${source_client_id_secret_key}",
          "source_client_secret_key": "${source_client_secret_key}",
          "source_client_id": "${source_client_id}",
          "source_client_secret": "${source_client_secret}",
          "source_token": "${source_token}",
          "run_id": "{{job.run_id}}"
        }
      }
    },
    {
      "task_key": "export",
      "depends_on": [
        {
          "task_key": "inventory"
        }
      ],
      "job_cluster_key": "uc_migration_cluster",
      "libraries": [
        {
          "pypi": {
            "package": "databricks-sdk>=0.36.0"
          }
        },
        {
          "pypi": {
            "package": "PyYAML>=6.0"
          }
        },
        {
          "pypi": {
            "package": "openpyxl>=3.1"
          }
        }
      ],
      "notebook_task": {
        "notebook_path": "${notebook_dir}/02_Export",
        "base_parameters": {
          "output_volume_path": "${output_volume_path}",
          "ops_catalog": "${ops_catalog}",
          "ops_schema": "${ops_schema}",
          "mapping_file_path": "${mapping_file_path}",
          "run_id": "{{job.run_id}}"
        }
      }
    }
  ]
}
