# Recreation config for the ai27 UC-migration test fixtures.
# Sourced by the *.sh scripts and read by recreate.py. Edit values here only.
#
# After a full Azure cleanup sweep, storage-account names may be re-usable (if truly
# freed) or squatted. If CREATE fails on a name clash, bump TOKEN to get fresh globally
# unique names — the SQL templating and EL/credential names follow from these vars.

# --- Azure ---
export SUB="edd4cc45-85c7-4aec-8bf5-648062d519bf"   # azure-sandbox-field-eng
export OWNER_TAG="abhishek.iyer@databricks.com"     # ARM policy requires an owner tag on every resource
export ADMIN="abhishek.iyer@databricks.com"         # UC metastore admin / grantee
export EXPORT_SP="71b85805-84f2-4185-86ae-bfadf34b6621"  # source export SP; needs USE/SELECT or SHOW CREATE fails

# Source side
export RG_SRC="ai27-uc-rg"
export REGION_SRC="eastus"
export GOV_ACCOUNT="ai27govd1a1e8"
export FIN_ACCOUNT="ai27find1a1e8"
export SALES_ACCOUNT="ai27sald1a1e8"
export GOV_CONNECTOR="ai27-gov-connector"
export FIN_CONNECTOR="ai27-fin-connector"
export SALES_CONNECTOR="ai27-sales-connector"
export CONTAINER="data"                              # single container per account; catalog root = container root

# Target side (Azure infra only; UC creds/ELs are normally created BY the migration)
export RG_TGT="ai27-uc-tgt-rg"
export REGION_TGT="eastus2"
export GOV_ACCOUNT_TGT="ai27tgtgove9fc8b"
export FIN_ACCOUNT_TGT="ai27tgtfine9fc8b"
export SALES_ACCOUNT_TGT="ai27tgtsale9fc8b"
export GOV_CONNECTOR_TGT="ai27-tgt-gov-e2"
export FIN_CONNECTOR_TGT="ai27-tgt-fin-e2"
export SALES_CONNECTOR_TGT="ai27-tgt-sales-e2"

# --- Databricks ---
export SRC_PROFILE="source_ws"
export TGT_PROFILE="target_ws"
export SRC_WAREHOUSE="eb2659cbee25f7d0"   # Serverless Starter (governance reads + fixture DDL)
export TGT_WAREHOUSE="4032a3c63316a01d"   # Serverless Starter (ABAC CREATE POLICY + audit)

# Catalog names (kept identical on source; target catalogs are produced by the migration)
export GOV_CATALOG="ai27_uc_gov_src"
export FIN_CATALOG="ai27_uc_finance"
export SALES_CATALOG="ai27_uc_sales"
