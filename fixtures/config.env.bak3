# Recreation config for the ai27 UC-migration test fixtures.
# Sourced by the *.sh scripts and read by recreate.py. Edit values here only.
#
# After a full Azure cleanup sweep, storage-account names may be re-usable (if truly
# freed) or squatted. If CREATE fails on a name clash, bump TOKEN to get fresh globally
# unique names — the SQL templating and EL/credential names follow from these vars.

# --- Azure ---
export SUB="edd4cc45-85c7-4aec-8bf5-648062d519bf"   # azure-sandbox-field-eng
export OWNER_TAG="abhishek.iyer@databricks.com"     # ARM policy requires an owner tag on every resource
export ADMIN="abhishek.iyer@databricks.com"         # UC metastore admin / grantee
export EXPORT_SP="71b85805-84f2-4185-86ae-bfadf34b6621"  # source export SP; needs USE/SELECT or SHOW CREATE fails

# Source side
export RG_SRC="ai27-uc-rg"
export REGION_SRC="eastus"
export GOV_ACCOUNT="ai27govd1a1e8"
export FIN_ACCOUNT="ai27find1a1e8"
export SALES_ACCOUNT="ai27sald1a1e8"
export GOV_CONNECTOR="ai27-gov-connector"
export FIN_CONNECTOR="ai27-fin-connector"
export SALES_CONNECTOR="ai27-sales-connector"
export CONTAINER="data"                              # single container per account; catalog root = container root

# Target side (Azure infra only; UC creds/ELs are normally created BY the migration)
export RG_TGT="ai27-uc-tgt-rg"
export REGION_TGT="eastus2"
export GOV_ACCOUNT_TGT="ai27tgtgove9fc8b"
export FIN_ACCOUNT_TGT="ai27tgtfine9fc8b"
export SALES_ACCOUNT_TGT="ai27tgtsale9fc8b"
export GOV_CONNECTOR_TGT="ai27-tgt-gov-e2"
export FIN_CONNECTOR_TGT="ai27-tgt-fin-e2"
export SALES_CONNECTOR_TGT="ai27-tgt-sales-e2"

# --- Databricks ---
export SRC_PROFILE="source_ws"
export TGT_PROFILE="target_ws"
export SRC_WAREHOUSE="d17c387e12f4f010"   # Serverless Starter (source)
export TGT_WAREHOUSE="84bef830cd844b1d"   # Serverless Starter (target)

# Catalog names (kept identical on source; target catalogs are produced by the migration)
export GOV_CATALOG="ai27_uc_gov_src"
export FIN_CATALOG="ai27_uc_finance"
export SALES_CATALOG="ai27_uc_sales"

# =====================================================================================
# ai27_ucsync_testcatalog — the single comprehensive test bed (every UC object + ACL).
# Its own dedicated Azure stack. Target side is created too (BYO mode: the migration
# runs with create_catalogs/schemas/storage_credentials/external_locations = false, so
# the target catalog/schemas/credential/EL must pre-exist).
# =====================================================================================
export TESTCAT_CATALOG="ai27_ucsync_testcatalog"

# Dedicated ADLS Gen2 accounts (global-unique; bump if a cleanup left a squatted name)
export TESTCAT_SRC_ACCOUNT="ai27ucsynctestsrc"     # source root (eastus, RG_SRC)
export TESTCAT_TGT_ACCOUNT="ai27ucsynctesttgt"     # target root (eastus2, RG_TGT)
export TESTCAT_SRC_CONNECTOR="ai27-ucsync-connector"
export TESTCAT_TGT_CONNECTOR="ai27-tgt-ucsync-e2"
export TESTCAT_SRC_CRED="ai27_ucsync_cred"         # source UC storage credential
export TESTCAT_SRC_EL="ai27_ucsync_el"             # source external location (account root)
export TESTCAT_TGT_CRED="ai27_ucsync_tgt_cred"     # target UC storage credential (BYO prereq)
export TESTCAT_TGT_EL="ai27_ucsync_tgt_el"         # target external location (BYO prereq)

# ACL-matrix identities (must be account-level so grant replay resolves on the target)
export TC_USER_ALL="abhishek.iyer@databricks.com"      # all privileges / owner
export TC_USER_READ="sanket.kelkar@databricks.com"     # schema-scoped reader
export TC_USER_USECAT="idris.chakera@databricks.com"   # USE CATALOG only (read-one/no-other)
export TC_SPN_WRITER="d1b18e5b-dec4-4a45-8b1e-36c444634423"  # ai27_uc_spn_1 (read+write)
export TC_SPN_READER="ce90d47b-0984-4b0f-afce-fd9612ec78a0"  # ai27_uc_spn_2 (read-only)
export TC_GROUP_READER="wsmig_acc_group"     # reader group
export TC_GROUP_ENGINEER="wsmig_acc_group_2" # engineer group (EXECUTE/APPLY TAG)
export TC_GROUP_ANALYST="wsmig_acc_group_3"  # analyst group (schema/table-scoped)
# Source-read principals for the eventual export (must exist + have SELECT/EXECUTE/READ
# VOLUME/MANAGE). The legacy EXPORT_SP 71b85805… was cleaned up; use the migration SPNs.
export TC_READ_SPN_1="ba5b12c9-acd5-469b-819c-5e15feb33bd9"  # ai27_ucmig_spn (job run-as)
export TC_READ_SPN_2="9a439328-0757-4826-aa76-502061018e8d"  # ai27_wsmig_source_spn (direct-mode source read)
